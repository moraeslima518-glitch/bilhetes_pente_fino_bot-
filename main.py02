import os
import requests
import telebot
from flask import Flask
from threading import Thread
import time
from datetime import datetime

TOKEN = os.getenv("TELEGRAM_TOKEN")
bot = telebot.TeleBot(TOKEN)

app = Flask('')

@app.route('/')
def home():
    return "Bot de Pente-Fino com Monitoramento Autônomo Rodando!"

def run_web():
    app.run(host='0.0.0.0', port=int(os.getenv("PORT", 10000)))

# Memória global para salvar os times dos bilhetes que você mandar
bilhetes_monitorados = []

# ==========================================
# 1. MOTOR DE PENTE-FINO (TEXTO E FOTOS)
# ==========================================
def analisar_pente_fino(texto_bilhete):
    texto_lower = texto_bilhete.lower()
    
    risco = "Moderado / Equilibrado"
    correcao = "O bilhete tem lógica, mas o bot já entrou em modo de vigília automática para te avisar quando o jogo rolar."
    mercado_alvo = "Linhas Padrão"

    if any(termo in texto_lower for termo in ["cartao", "cartões", "amarelo", "vermelho", "falta", "faltas", "quente"]):
        risco = "Alto / Volátil (Jogo ríspido detectado)"
        mercado_alvo = "Mercado de Cartões e Disciplina"
        correcao = "⚠️ Alerta de Jogo Quente no Bilhete! O bot vai te monitorar e avisar se o jogo esquentar para cartão vermelho."

    elif any(termo in texto_lower for termo in ["canto", "cantos", "escanteio", "escanteios", "3 escanteios", "4 escanteios"]):
        risco = "Controlado / Oportunidade Live"
        mercado_alvo = "Cantos Asiáticos / Pressão pelas Pontas"
        correcao = "🚩 Alerta de Cantos no Bilhete! O bot vigiará a pressão inicial para as estiradas de escanteios."

    elif any(termo in texto_lower for termo in ["1° tempo", "primeiro tempo", "ht", "intervalo"]):
        risco = "Arrojado (Volatilidade Alta no HT)"
        mercado_alvo = "Gols ou Pressão no Primeiro Tempo"
        correcao = "⏱️ Alerta de 1º Tempo no Bilhete! O bot vai acompanhar o ritmo relâmpago dos primeiros 45 minutos."

    resposta_analise = (
        f"🔍 *PENTE-FINO & VIGÍLIA AUTÔNOMA ATIVADA* 🔍\n\n"
        f"📝 *Referência:* _{texto_bilhete}_\n\n"
        f"🎯 *Foco:* `{mercado_alvo}` | 📊 *Risco:* `{risco}`\n\n"
        f"💡 *Diagnóstico:* {correcao}\n\n"
        f"🤖 *Status:* Bilhete registrado! Assim que a partida começar, **eu te mandarei os alertas ao vivo sozinho**, sem precisar de comandos."
    )
    return resposta_analise

# ==========================================
# 2. VARREDURA AUTOMÁTICA EM SEGUNDO PLANO (AUTÔNOMA)
# ==========================================
def varredura_autonoma_jogos():
    # Dicionário para controlar para quais jogos já mandamos alerta hoje, para não repetir toda hora
    alertas_enviados = set()
    
    while True:
        try:
            if bilhetes_monitorados:
                data_hoje = datetime.now().strftime("%Y%m%d")
                url = f"https://site.api.espn.com/apis/site/v2/sports/soccer/scoreboard?dates={data_hoje}"
                response = requests.get(url, timeout=10)
                
                if response.status_code == 200:
                    data = response.json()
                    events = data.get("events", [])
                    
                    for event in events:
                        status_type = event.get("status", {}).get("type", {}).get("state", "")
                        # Se o jogo estiver rolando ao vivo ("in")
                        if status_type == "in":
                            competition = event.get("competitions", [{}])[0]
                            competitors = competition.get("competitors", [])
                            if len(competitors) < 2:
                                continue
                                
                            home_team = competitors[0].get("team", {}).get("displayName", "")
                            away_team = competitors[1].get("team", {}).get("displayName", "")
                            home_score = competitors[0].get("score", "0")
                            away_score = competitors[1].get("score", "0")
                            clock = event.get("status", {}).get("displayClock", "AO VIVO")
                            
                            id_partida = f"{home_team}-{away_team}"
                            
                            # Verifica se o jogo rolando bate com algum bilhete que você enviou
                            for item in bilhetes_monitorados:
                                chat_id = item["chat_id"]
                                texto_alvo = item["texto"].lower()
                                
                                # Se o nome de algum dos times do bilhete estiver rodando e ainda não avisamos
                                if (home_team.lower() in texto_alvo or away_team.lower() in texto_alvo) and id_partida not in alertas_enviados:
                                    
                                    # Monta a mensagem autônoma personalizada baseada no que você pediu no bilhete
                                    aviso_autonomo = (
                                        f"🚨 *ALERTA AUTÔNOMA AO VIVO!* 🚨\n\n"
                                        f"O jogo do seu bilhete começou a rolar:\n"
                                        f"⚡ *{home_team} {home_score} x {away_score} {away_team}* (`{clock}`)\n\n"
                                        f"📊 *Análise do Momento:* \n"
                                        f"• Olho aberto no **1º Tempo (HT)** e no volume de ataques pelas pontas para **cantos**.\n"
                                        f"• Se o jogo estiver picotado com faltas seguidas, atenção redobrada ao **risco de cartão vermelho**!\n\n"
                                        f"🤖 *Veredito:* Acompanhe o desenrolar agora com base no seu pente-fino!"
                                    )
                                    
                                    try:
                                        bot.send_message(chat_id, aviso_autonomo, parse_mode="Markdown")
                                        alertas_enviados.add(id_partida)
                                    except Exception:
                                        pass
        except Exception:
            pass
        # Checa a cada 60 segundos de forma totalmente silenciosa e automática
        time.sleep(60)

# ==========================================
# 3. HANDLERS DO TELEGRAM
# ==========================================
@bot.message_handler(commands=['start', 'ajuda'])
def send_welcome(message):
    ajuda_texto = (
        "🤖 *Bot de Pente-Fino com Inteligência Autônoma*\n\n"
        "Como funciona agora:\n"
        "1. Você **manda o texto ou a foto do seu bilhete** a qualquer momento.\n"
        "2. O bot registra os times automaticamente.\n"
        "3. Quando a partida começar, **ele te manda os alertas ao vivo sozinho**, sem você precisar digitar nenhum comando!\n\n"
        "Pode mandar seu bilhete ou print direto aqui!"
    )
    bot.reply_to(message, ajuda_texto, parse_mode="Markdown")

# Handler para FOTOS de bilhetes com registro automático
@bot.message_handler(content_types=['photo'])
def handle_foto_bilhete(message):
    try:
        chat_id = message.chat.id
        bot.reply_to(message, "📸 *Print de bilhete capturado!* Registrei os dados e ativei o modo de **Vigília Autônoma**. Quando o jogo começar, te aviso aqui sozinho!", parse_mode="Markdown")
        
        # Salva na memória do bot para monitoramento automático
        bilhetes_monitorados.append({
            "chat_id": chat_id,
            "texto": "bilhete print futebol jogo cartao canto ht"
        })
    except Exception as e:
        bot.reply_to(message, f"⚠️ Erro ao registrar foto: {str(e)}", parse_mode="Markdown")

@bot.message_handler(func=lambda message: True)
def handle_texto_livre(message):
    try:
        chat_id = message.chat.id
        texto = message.text
        
        # Se for comando start ou ajuda, deixa passar
        if texto.startswith('/'):
            return
            
        # Analisa o bilhete
        resultado = analisar_pente_fino(texto)
        bot.reply_to(message, resultado, parse_mode="Markdown")
        
        # Salva automaticamente na lista para o bot monitorar sozinho quando o jogo começar
        bilhetes_monitorados.append({
            "chat_id": chat_id,
            "texto": texto
        })
    except Exception as e:
        pass

if __name__ == '__main__':
    t_web = Thread(target=run_web)
    t_web.start()
    
    # Inicia a inteligência autônoma que vigia os jogos em segundo plano
    t_autonoma = Thread(target=varredura_autonoma_jogos, daemon=True)
    t_autonoma.start()
    
    print("Bot com vigilância e alertas autônomos rodando...")
    bot.infinity_polling()

